# Copy to .env.production and replace every placeholder with a unique secret.
# Do not commit .env.production. Generate secrets with: openssl rand -hex 32

NODE_ENV=production
PORT=5000

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_INTERNAL_KEY
DEVICE_SECRET=REPLACE_WITH_RANDOM_DEVICE_SECRET

MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=yarsalam
MYSQL_USER=appuser
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_APP_PASSWORD
DB_SYNC=false
DB_POOL_SIZE=45

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD_IF_CONFIGURED

CORS_ORIGINS=https://YOUR_USER_DOMAIN
FRONTEND_URL=https://YOUR_USER_DOMAIN
APP_URL=https://YOUR_API_DOMAIN

AI_ASSISTANT_URL=http://ai_assistant:8022
AI_MODERATION_URL=http://ai_moderation:8018
AI_SUPPORT_URL=http://ai_support:8016
AEO_TRACKER_URL=http://aeo_tracker:8030
PERSONALITY_AI_URL=http://personality:8100
FACE_VERIFICATION_URL=http://ai_verification:8017
PYTHON_AI_URL=http://ml_service:8000

CMS_API_URL=
RECAPTCHA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_API_KEY=
SERPAPI_KEY=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
BACKLINK_API_KEY=
SEMRUSH_API_KEY=
